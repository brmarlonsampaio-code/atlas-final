# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env (já está no .gitignore).

# String de conexão do Postgres/Supabase com PostGIS habilitado.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave usada pelo painel administrativo (upload/edição/exclusão).
# Gere algo aleatório, ex: openssl rand -hex 16
ADMIN_API_KEY=troque-por-uma-chave-aleatoria-longa

PORT=3001
